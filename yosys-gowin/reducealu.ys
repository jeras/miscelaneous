##################################################################

read_verilog -sv -icells <<EOT

module top(input [32-1:0] A, output Y);
  \$reduce_and #(
    .A_SIGNED(32'd0),
    .A_WIDTH(32'd32),
    .Y_WIDTH(32'd1)
  ) uut (
    .A(A),
    .Y(Y)
  );
endmodule

EOT

copy top top_unmapped

#equiv_opt -assert techmap -map gowin/reducealu.v -map gowin/CLS.v top

techmap -map gowin/reducealu.v -map gowin/CLS.v top
clean

#select -module top -assert-count 8 t:CLS

#show -stretch top
#select -list

flatten
opt_clean -purge
miter -equiv -make_assert -flatten top_unmapped top miter
sat -verify -prove-asserts -set-def-inputs -show-public miter

design -reset
